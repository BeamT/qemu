# NimBLE host only, talking HCI to a controller outside the chip over UART1
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=y
CONFIG_BT_NIMBLE_TRANSPORT_UART_PORT=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# On by default for the ESP32; Rootcanal (and so netsim) does not implement
# HCI Set Controller To Host Flow Control
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=n
